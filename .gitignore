# Runtime JSON/checkpoint outputs from the executable stages.  The curated
# top-level results/ directory remains tracked.
02_whisper_sync/results/
03_whisper_ensemble/results/
04_whisper_async/results/

# Checkpoints are documented but not bundled.
checkpoints/*
!checkpoints/README.md
!checkpoints/release_manifest.json
*.pth
*.pt
*.ckpt
*.safetensors

# Upstream MEL code is fetched at a pinned commit and remains a separate checkout.
01_mel_baseline/upstream/
