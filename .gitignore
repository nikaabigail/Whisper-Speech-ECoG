# This repository publishes source code and curated result figures only.
# Raw recordings, derived arrays, caches, logs, and model weights must stay local.

# Python / tooling
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/

# Local editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Secrets and machine-specific configuration
.env
.env.*
!.env.example
**/patients.json
!**/patients.example.json

# Raw or derived research data (never publish)
data/
dataset/
datasets/
**/data/
**/dataset/
**/datasets/
# The external-validation package has a Python ``data`` namespace containing
# read-only adapters (never recordings). Keep those source files publishable.
!05_external_validation/src/whisper_ecog_ext/data/
# Re-ignore every payload in the source namespace, then admit only reviewed code.
05_external_validation/src/whisper_ecog_ext/data/*
!05_external_validation/src/whisper_ecog_ext/data/__init__.py
!05_external_validation/src/whisper_ecog_ext/data/vocalmind.py
*.zip
*.nwb
*.xdf
*.csv
*.tsv
*.h5
*.hdf5
*.mat
*.edf
*.bdf
*.fif
*.vhdr
*.vmrk
*.eeg
*.set
*.wav
*.flac
*.TextGrid
*_words.txt
*.npy
*.npz
*.pkl
*.pickle

